#!/usr/bin/env python3
"""mkfldhdr shim: generate Rust UBF field constants from a .fd field table.

Enduro/X 8.0.10 ships an mkfldhdr without the Rust language mode (-m4) that
the endurox-rs build script invokes. This shim implements just enough of the
interface: `mkfldhdr-rust -m4 -d <outdir> <table.fd>...` writes `<table>.rs`
with `pub const <NAME>: i32 = <BFLDID32>;` entries.

Point the endurox-rs build at it via:
    export ENDUROX_MKFLDHDR=$PWD/tools/mkfldhdr-rust
(the workspace .cargo/config.toml does this automatically).
"""
import sys
from pathlib import Path

# BFLDID32 type codes (see /usr/include/ubf.h)
TYPES = {
    "short": 0,
    "long": 1,
    "char": 2,
    "float": 3,
    "double": 4,
    "string": 5,
    "carray": 6,
    "ptr": 9,
    "ubf": 10,
    "fml32": 10,
    "view": 11,
    "view32": 11,
}

EFFECTIVE_BITS = 25  # BFLDID32 = (type << 25) | number


def parse_fd(path: Path):
    base = 0
    fields = []
    for raw_line in path.read_text().splitlines():
        line = raw_line.strip()
        if not line or line.startswith(("#", "$")):
            continue
        if line.startswith("*base"):
            base = int(line.split()[1])
            continue
        parts = line.split()
        if len(parts) < 3 or parts[2].lower() not in TYPES:
            continue
        name, number, ftype = parts[0], int(parts[1]), parts[2].lower()
        fldid = (TYPES[ftype] << EFFECTIVE_BITS) | (base + number)
        fields.append((name, fldid, base + number, ftype))
    return fields


def main(argv):
    outdir = Path(".")
    tables = []
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == "-d":
            i += 1
            outdir = Path(argv[i])
        elif arg.startswith("-d") and len(arg) > 2:
            outdir = Path(arg[2:])
        elif arg in ("-m", "-D", "-p"):
            i += 1  # value consumed; language mode is always Rust here
        elif arg.startswith("-"):
            pass
        else:
            tables.append(Path(arg))
        i += 1

    if not tables:
        print("mkfldhdr-rust: no field tables given", file=sys.stderr)
        return 1

    outdir.mkdir(parents=True, exist_ok=True)
    for table in tables:
        fields = parse_fd(table)
        stem = table.name
        for suffix in (".fd",):
            if stem.endswith(suffix):
                stem = stem[: -len(suffix)]
        out = outdir / f"{stem}.rs"
        with out.open("w") as f:
            f.write(f"// Auto-generated by mkfldhdr-rust from {table.name}. DO NOT EDIT.\n")
            for name, fldid, number, ftype in fields:
                f.write(f"/// number: {number}, type: {ftype}\n")
                f.write(f"pub const {name}: i32 = {fldid};\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
